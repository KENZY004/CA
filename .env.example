# ==============================================================================
# Challengers Volleyball Academy - Environment Configuration
# ==============================================================================

# Server Port (Default is 3000)
PORT=3000

# Academy Admin Notification Email (Receives "New Session Registration" notifications)
ACADEMY_ADMIN_EMAIL="admin@challengersvolleyball.com"

# ------------------------------------------------------------------------------
# 1. MongoDB Database Configuration
# ------------------------------------------------------------------------------
# MongoDB Connection String (e.g. MongoDB Atlas cloud or local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME="challengers_academy"

# ------------------------------------------------------------------------------
# 2. Stripe Payment Configuration
# ------------------------------------------------------------------------------
# Get your API keys from: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# Stripe Webhook Signing Secret (from Stripe CLI or Stripe Dashboard Webhooks)
# e.g., run `stripe listen --forward-to localhost:3000/api/stripe-webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# ------------------------------------------------------------------------------
# 3. WhatsApp Support Number (Optional)
# ------------------------------------------------------------------------------
VITE_WHATSAPP_NUMBER="18638459913"

# ------------------------------------------------------------------------------
# 4. JWT Authentication
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens — make this long and random!
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# ------------------------------------------------------------------------------
# 5. Google OAuth (Optional — for Google Sign-In on admin login)
# ------------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/ > APIs & Services > Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VITE_GOOGLE_CLIENT_ID=""

# ------------------------------------------------------------------------------
# 7. Email Configuration (For password reset emails)
# ------------------------------------------------------------------------------
# Gmail Example: use an App Password (not your regular Gmail password)
# Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your@gmail.com"
EMAIL_PASS="your-16-char-app-password"
EMAIL_FROM="Challengers Academy <your@gmail.com>"

# ------------------------------------------------------------------------------
# 8. App URL (used for password reset links)
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 9. First Admin Seed Credentials (used on FIRST startup if no admins exist)
# ------------------------------------------------------------------------------
ADMIN_SEED_EMAIL="admin@challengersvolleyball.com"
ADMIN_SEED_PASSWORD="ChangeMe@2024!"
